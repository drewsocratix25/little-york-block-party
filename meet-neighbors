<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Meet the Neighbors — Kitner, Shady &amp; Oviatt Block Party</title>
<meta name="description" content="A quick questionnaire so we can introduce you to the rest of the neighborhood before the block party.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Patrick+Hand&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&display=swap" rel="stylesheet">
<style>
:root {
  --cream:        #faf3e3;
  --cream-deep:   #f0e6cd;
  --ink:          #1f1812;
  --ink-soft:     #4a3a2c;
  --tomato:       #d94427;
  --tomato-deep:  #a8321a;
  --sky:          #4a90a4;
  --grass:        #6b8e3a;
  --sunny:        #e8b13a;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  color-scheme: light;
  background: var(--cream);
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  background: var(--cream) !important;
  color: var(--ink) !important;
  color-scheme: light;
  font-family: 'Fraunces', Georgia, serif;
  font-size: 18px;
  line-height: 1.55;
  min-height: 100vh;
  forced-color-adjust: none;
  background-image:
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch' seed='5'/><feColorMatrix values='0 0 0 0 0.12  0 0 0 0 0.09  0 0 0 0 0.07  0 0 0 0.07 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

a:focus-visible, button:focus-visible, input:focus-visible,
select:focus-visible, textarea:focus-visible {
  outline: 3px solid var(--tomato);
  outline-offset: 3px;
}

::selection { background: var(--tomato); color: var(--cream); }

.page { max-width: 760px; margin: 0 auto; padding: 32px 24px 64px; }

/* ============ BACK LINK ============ */
.back-link {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  color: var(--ink);
  text-decoration: none;
  border-bottom: 1.5px solid var(--ink);
  display: inline-block;
  margin-bottom: 28px;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.back-link:hover { color: var(--tomato); border-color: var(--tomato); }

/* ============ HEADER ============ */
.hdr { text-align: center; padding: 16px 0 28px; }

.hdr-tag {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 20px;
  color: var(--tomato);
  letter-spacing: 1px;
  display: inline-block;
  transform: rotate(-2deg);
  margin-bottom: 8px;
}

.hdr h1 {
  font-family: 'Caveat Brush', cursive;
  font-weight: 400;
  font-size: clamp(48px, 9vw, 76px);
  line-height: 0.92;
  color: var(--ink);
  letter-spacing: -1px;
  margin: 4px 0 16px;
  text-shadow: 2px 2px 0 rgba(217, 68, 39, 0.12);
}

.hdr h1 .accent {
  color: var(--tomato);
  display: inline-block;
  transform: rotate(-2deg);
}

.hdr-sub {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 22px;
  color: var(--ink);
  max-width: 540px;
  margin: 0 auto;
  line-height: 1.4;
}

/* ============ INTRO CARD ============ */
.intro {
  background: var(--cream);
  border: 3px solid var(--ink);
  padding: 28px 32px;
  margin: 0 auto 36px;
  max-width: 640px;
  box-shadow: 5px 5px 0 var(--sky);
  transform: rotate(-0.3deg);
}

.intro p {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 12px;
}

.intro p:last-child { margin-bottom: 0; }

.intro p strong {
  font-weight: 600;
  color: var(--tomato-deep);
}

.intro-bullets {
  margin: 14px 0 8px;
  padding-left: 24px;
}
.intro-bullets li {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 6px;
}
.intro-bullets li::marker { color: var(--tomato); }

/* ============ FORM ============ */
.form {
  background: var(--cream);
  border: 3px solid var(--ink);
  padding: 36px 36px 32px;
  box-shadow: 6px 6px 0 var(--tomato);
}
@media (max-width: 540px) { .form { padding: 24px 20px; } }

.form-section {
  margin-bottom: 32px;
  padding-bottom: 28px;
  border-bottom: 2px dashed var(--ink);
}
.form-section:last-of-type { border-bottom: none; margin-bottom: 0; }

.section-label {
  display: inline-block;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 15px;
  color: var(--cream);
  background: var(--ink);
  padding: 4px 12px;
  letter-spacing: 1px;
  margin-bottom: 12px;
  transform: rotate(-1deg);
}

.section-headline {
  font-family: 'Caveat Brush', cursive;
  font-size: 32px;
  color: var(--ink);
  line-height: 1;
  margin-bottom: 16px;
}

.field { margin-bottom: 22px; }

.field-label {
  display: block;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 20px;
  color: var(--ink);
  margin-bottom: 6px;
  line-height: 1.3;
}

.field-label .req { color: var(--tomato); margin-left: 2px; }

.field-hint {
  display: block;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 15px;
  color: var(--ink-soft);
  margin-bottom: 8px;
  margin-top: -2px;
}

.field input[type="text"],
.field input[type="email"],
.field input[type="number"] {
  width: 100%;
  background: var(--cream);
  border: 2px solid var(--ink);
  font-family: 'Fraunces', serif;
  font-size: 18px;
  color: var(--ink);
  padding: 10px 12px;
  border-radius: 0;
  appearance: none;
}

.field textarea {
  width: 100%;
  background: var(--cream);
  border: 2px solid var(--ink);
  font-family: 'Fraunces', serif;
  font-size: 17px;
  line-height: 1.5;
  color: var(--ink);
  padding: 12px;
  min-height: 90px;
  resize: vertical;
  border-radius: 0;
}

.field input::placeholder, .field textarea::placeholder {
  color: rgba(31, 24, 18, 0.45);
  font-style: italic;
}

.field input:focus, .field textarea:focus {
  outline: none;
  border-color: var(--tomato);
  background: #fffaef;
}

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
@media (max-width: 540px) { .field-row { grid-template-columns: 1fr; gap: 22px; } }

.photo-upload {
  background: var(--cream-deep);
  border: 2px dashed var(--ink);
  padding: 24px;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
}
.photo-upload:hover {
  border-color: var(--tomato);
  background: #fff7e8;
}
.photo-upload input { display: none; }

.photo-upload-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 8px;
  color: var(--tomato);
}
.photo-upload-icon svg { width: 100%; height: 100%; }

.photo-upload-text {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  color: var(--ink);
}
.photo-upload-text .small {
  display: block;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 14px;
  color: var(--ink-soft);
  margin-top: 4px;
}

.photo-preview {
  display: none;
  margin-top: 16px;
  padding: 12px;
  background: var(--cream);
  border: 2px solid var(--ink);
  text-align: center;
}
.photo-preview.show { display: block; }
.photo-preview img {
  max-width: 100%;
  max-height: 280px;
  border: 1px solid var(--ink);
}
.photo-preview .filename {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 16px;
  color: var(--ink);
  margin-top: 8px;
}

.submit-row {
  text-align: center;
  margin-top: 32px;
  padding-top: 24px;
}

.cta {
  display: inline-block;
  padding: 16px 32px;
  background: var(--tomato);
  color: var(--cream);
  font-family: 'Patrick Hand', sans-serif;
  font-size: 24px;
  letter-spacing: 1px;
  text-decoration: none;
  border: 3px solid var(--ink);
  box-shadow: 5px 5px 0 var(--ink);
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  transform: rotate(-1deg);
}
.cta:hover { transform: rotate(-1deg) translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
.cta:active { transform: rotate(-1deg) translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }

.confirmation {
  display: none;
  margin-top: 24px;
  padding: 24px;
  background: var(--ink);
  color: var(--cream);
  text-align: center;
  transform: rotate(-0.5deg);
  box-shadow: 4px 4px 0 var(--tomato);
}
.confirmation.show { display: block; }
.confirmation h4 {
  font-family: 'Caveat Brush', cursive;
  font-size: 32px;
  color: var(--cream);
  margin-bottom: 4px;
}
.confirmation p {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  color: var(--cream);
}

.error-message {
  display: none;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 16px;
  color: var(--tomato);
  margin-top: 4px;
}
.error-message.show { display: block; }
.field input.error { border-color: var(--tomato); border-width: 3px; }

footer {
  margin-top: 60px;
  padding: 28px 16px 0;
  border-top: 3px dashed var(--ink);
  text-align: center;
}
footer p {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 17px;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 8px;
}
footer a {
  color: var(--tomato-deep);
  text-decoration: none;
  border-bottom: 2px solid var(--tomato);
}

@keyframes popIn {
  0%   { opacity: 0; transform: translateY(20px) scale(0.96); }
  60%  { opacity: 1; transform: translateY(-4px) scale(1.01); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.hdr, .intro, .form {
  animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.intro { animation-delay: 0.15s; }
.form { animation-delay: 0.3s; }
</style>
</head>
<body>

<div class="page">

  <a href="index.html" class="back-link">← Back to the block party</a>

  <header class="hdr">
    <p class="hdr-tag">— before the party —</p>
    <h1>Meet <span class="accent">the Neighbors</span></h1>
    <p class="hdr-sub">A few questions so we can introduce you to the neighborhood on our Facebook group.</p>
  </header>

  <section class="intro">
    <p><strong>Here's the idea:</strong> in the weeks leading up to August 1, we want to introduce everybody across Kitner, Shady, and Oviatt to each other. We'll post a short profile of you on the neighborhood Facebook group — a photo, a few sentences about your household, what brought you here, what you're into.</p>
    <p>This is the questionnaire. Five minutes, tops. Skip anything you'd rather not share.</p>
    <p style="margin-top: 14px;"><strong>What we'll do with it:</strong></p>
    <ul class="intro-bullets">
      <li>Write a short, friendly post about your household (1–2 paragraphs)</li>
      <li>Post it on the private FB group with your photo</li>
      <li>Send you the draft first so you can approve or change anything before it goes up</li>
    </ul>
  </section>

  <form class="form" id="meet-form" onsubmit="return submitProfile(event)">

    <!-- ===== BASICS ===== -->
    <div class="form-section">
      <p class="section-label">the basics</p>
      <p class="section-headline">First, the easy stuff</p>

      <div class="field">
        <label class="field-label" for="m-household">
          Household / family name <span class="req" aria-hidden="true">*</span>
        </label>
        <span class="field-hint">How we should refer to you in the post (e.g., "The Brush Family" or "Drew &amp; Grace")</span>
        <input type="text" id="m-household" required placeholder="e.g., The Brush Family">
        <div class="error-message" id="m-household-err" role="alert">Need a household name so we know how to introduce you.</div>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field-label" for="m-firstnames">
            First names (everyone)
          </label>
          <input type="text" id="m-firstnames" placeholder="e.g., Drew, Grace, Max (dog)">
        </div>
        <div class="field">
          <label class="field-label" for="m-address">
            House number
          </label>
          <input type="text" id="m-address" placeholder="e.g., 7643">
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="m-email">
          Your email <span class="req" aria-hidden="true">*</span>
        </label>
        <span class="field-hint">So we can send you the draft before posting.</span>
        <input type="email" id="m-email" required placeholder="you@example.com">
        <div class="error-message" id="m-email-err" role="alert">We need an email to send you the draft.</div>
      </div>
    </div>

    <!-- ===== STORY ===== -->
    <div class="form-section">
      <p class="section-label">your story</p>
      <p class="section-headline">Tell us about you</p>

      <div class="field">
        <label class="field-label" for="m-howlong">
          How long have you been in the neighborhood?
        </label>
        <input type="text" id="m-howlong" placeholder="e.g., 3 years, 50 years, just moved in last month">
      </div>

      <div class="field">
        <label class="field-label" for="m-whyhere">
          Why did you pick our little block?
        </label>
        <span class="field-hint">What drew you here? Schools? A specific house? Family? Word of mouth?</span>
        <textarea id="m-whyhere" placeholder="A few sentences is great..."></textarea>
      </div>

      <div class="field">
        <label class="field-label" for="m-household-desc">
          Who's in your household?
        </label>
        <span class="field-hint">Kids, grandkids, pets, the works. Anyone you'd want neighbors to know about.</span>
        <textarea id="m-household-desc" placeholder="e.g., Just the two of us now, but we raised three kids here who visit often..."></textarea>
      </div>

      <div class="field">
        <label class="field-label" for="m-from">
          Where are you originally from?
        </label>
        <input type="text" id="m-from" placeholder="e.g., grew up in Akron, lived in Pittsburgh before this">
      </div>
    </div>

    <!-- ===== COMMUNITY & FUN ===== -->
    <div class="form-section">
      <p class="section-label">what you love</p>
      <p class="section-headline">Your favorite things</p>

      <div class="field">
        <label class="field-label" for="m-northfield">
          What do you love about Northfield / the area?
        </label>
        <span class="field-hint">Favorite places, restaurants, the parks, the schools — whatever you'd recommend.</span>
        <textarea id="m-northfield" placeholder="A few favorites..."></textarea>
      </div>

      <div class="field">
        <label class="field-label" for="m-fun">
          What does your household like to do for fun?
        </label>
        <span class="field-hint">Hobbies, weekend stuff, things you're known for. The more specific, the better.</span>
        <textarea id="m-fun" placeholder="e.g., big into pickleball, bird watching at CVNP, our backyard fire pit..."></textarea>
      </div>

      <div class="field">
        <label class="field-label" for="m-anything">
          Anything else you'd want neighbors to know?
        </label>
        <span class="field-hint">Big life stuff, what you're looking forward to, something quirky. Totally optional.</span>
        <textarea id="m-anything" placeholder="e.g., baby on the way, recently retired, just adopted a puppy..."></textarea>
      </div>
    </div>

    <!-- ===== PHOTO ===== -->
    <div class="form-section">
      <p class="section-label">a photo</p>
      <p class="section-headline">A family photo</p>
      <p style="font-family: 'Fraunces', serif; font-size: 17px; line-height: 1.55; color: var(--ink); margin-bottom: 16px;">
        Anything you'd be happy to share with the neighborhood — household, pets, you doing something you love. Doesn't need to be perfect.
      </p>

      <label class="photo-upload" for="m-photo">
        <div class="photo-upload-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <rect x="6" y="12" width="36" height="28" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M14 12 L 17 8 L 31 8 L 34 12" stroke="currentColor" stroke-width="2" fill="none"/>
            <circle cx="24" cy="26" r="8" stroke="currentColor" stroke-width="2"/>
            <circle cx="24" cy="26" r="3" fill="currentColor"/>
            <circle cx="36" cy="18" r="1.5" fill="currentColor"/>
          </svg>
        </div>
        <div class="photo-upload-text">
          Tap to upload a photo
          <span class="small">jpg, png — any size</span>
        </div>
        <input type="file" id="m-photo" accept="image/*" onchange="previewPhoto(event)">
      </label>

      <div class="photo-preview" id="photo-preview" aria-live="polite">
        <img id="photo-img" alt="Your uploaded photo preview">
        <p class="filename" id="photo-filename"></p>
      </div>
    </div>

    <div class="submit-row">
      <button type="submit" class="cta">Send it our way! →</button>
    </div>

    <div class="confirmation" id="confirmation" role="status" aria-live="polite">
      <h4>Got it — thanks!</h4>
      <p>We'll draft your profile and send it over before posting. Talk soon.</p>
    </div>

  </form>

  <footer>
    <p>Questions? Knock on <strong>7643</strong> or call <a href="tel:+13304283462">(330)&nbsp;428-3462</a>.</p>
  </footer>

</div>

<script>
// Supabase config (same project as the main site)
const SUPABASE_URL = 'https://crdxgaqpluvdcropvxrk.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyZHhnYXFwbHV2ZGNyb3B2eHJrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0NTg0MDUsImV4cCI6MjA5NTAzNDQwNX0.nzBjPEWp1fdb-tFkvh5Z5wjWQtHOOT9g0tQ3KHIviAc';

function previewPhoto(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(ev) {
    document.getElementById('photo-img').src = ev.target.result;
    document.getElementById('photo-filename').textContent = file.name;
    document.getElementById('photo-preview').classList.add('show');
  };
  reader.readAsDataURL(file);
}

async function submitProfile(e) {
  e.preventDefault();

  const householdEl = document.getElementById('m-household');
  const emailEl = document.getElementById('m-email');
  let valid = true;

  // Reset errors
  [householdEl, emailEl].forEach(el => {
    el.classList.remove('error');
    el.removeAttribute('aria-invalid');
  });
  document.getElementById('m-household-err').classList.remove('show');
  document.getElementById('m-email-err').classList.remove('show');

  if (!householdEl.value.trim()) {
    householdEl.classList.add('error');
    householdEl.setAttribute('aria-invalid', 'true');
    document.getElementById('m-household-err').classList.add('show');
    valid = false;
  }
  if (!emailEl.value.trim()) {
    emailEl.classList.add('error');
    emailEl.setAttribute('aria-invalid', 'true');
    document.getElementById('m-email-err').classList.add('show');
    valid = false;
  }

  if (!valid) {
    (document.querySelector('input.error') || document.querySelector('textarea.error'))?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return false;
  }

  const submitBtn = document.querySelector('.submit-row .cta');
  const originalLabel = submitBtn.textContent;
  submitBtn.disabled = true;
  submitBtn.textContent = 'Sending...';

  const payload = {
    household_name: householdEl.value.trim(),
    first_names: document.getElementById('m-firstnames').value.trim() || null,
    street_address: document.getElementById('m-address').value.trim() || null,
    email: emailEl.value.trim(),
    how_long: document.getElementById('m-howlong').value.trim() || null,
    why_here: document.getElementById('m-whyhere').value.trim() || null,
    household_desc: document.getElementById('m-household-desc').value.trim() || null,
    originally_from: document.getElementById('m-from').value.trim() || null,
    northfield_love: document.getElementById('m-northfield').value.trim() || null,
    fun_activities: document.getElementById('m-fun').value.trim() || null,
    anything_else: document.getElementById('m-anything').value.trim() || null,
    photo_filename: document.getElementById('m-photo').files[0]?.name || null,
    photo_url: null  // photo upload to storage to be added separately
  };

  try {
    const response = await fetch(`${SUPABASE_URL}/rest/v1/meet_the_neighbors`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      const text = await response.text();
      throw new Error(`Supabase error ${response.status}: ${text.slice(0, 200)}`);
    }

    document.getElementById('confirmation').classList.add('show');
    document.getElementById('confirmation').scrollIntoView({ behavior: 'smooth', block: 'center' });
    document.getElementById('meet-form').reset();
    document.getElementById('photo-preview').classList.remove('show');

  } catch (err) {
    console.error('Profile submission failed:', err);
    const confirmEl = document.getElementById('confirmation');
    confirmEl.querySelector('h4').textContent = 'Something went wrong';
    confirmEl.querySelector('p').textContent = "Couldn't save your answers. Try again, or knock on 7643 Kitner.";
    confirmEl.classList.add('show');
    confirmEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = originalLabel;
  }

  return false;
}
</script>

</body>
</html>

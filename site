<script>
const rsvps = [];

function submitRsvp() {
  const nameEl = document.getElementById('f-name');
  const errEl = document.getElementById('f-name-err');
  const name = nameEl.value.trim();
  const headcount = document.getElementById('f-headcount').value;
  const attending = document.querySelector('input[name="attending"]:checked').value;
  const bringingCat = document.getElementById('f-bringing').value;
  const dish = document.getElementById('f-dish').value.trim();
  const contribs = Array.from(document.querySelectorAll('.check-row input:checked')).map(c => c.value);

  if (!name) {
    nameEl.classList.add('error');
    nameEl.setAttribute('aria-invalid', 'true');
    errEl.classList.add('show');
    nameEl.focus();
    nameEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return;
  }
  nameEl.classList.remove('error');
  nameEl.removeAttribute('aria-invalid');
  errEl.classList.remove('show');

  if (attending === 'no') {
    showConfirmation("Aw, sorry we'll miss ya. We'll save you a plate in spirit.");
    resetForm();
    return;
  }

  const bringing = dish || bringingCat || 'TBD';

  const noteParts = [];
  if (headcount) noteParts.push(`party of ${headcount}`);
  if (contribs.length) {
    const map = { grill: 'grill', canopy: 'canopy', table: 'table', chairs: 'chairs',
                  cooler: 'cooler', speaker: 'speaker', cornhole: 'cornhole', kids: "kids' stuff" };
    noteParts.push('also bringing ' + contribs.map(c => map[c]).join(', '));
  }
  if (attending === 'maybe') noteParts.unshift('(tentative)');

  rsvps.push({ name, bringing, note: noteParts.join(' · ') || '—' });
  renderList();
  showConfirmation();
  resetForm();
}

function renderList() {
  const c = document.getElementById('list-rows');
  if (!rsvps.length) {
    c.innerHTML = '<div class="list-empty">Nobody\'s signed up yet — be the first!</div>';
    return;
  }
  c.innerHTML = rsvps.map(r => `
    <div class="list-row">
      <div class="r-name">${escapeHtml(r.name)}</div>
      <div class="r-bringing">${escapeHtml(r.bringing)}</div>
      <div class="r-note">${escapeHtml(r.note)}</div>
    </div>
  `).join('');
}

function showConfirmation(custom) {
  const c = document.getElementById('confirmation');
  c.querySelector('p').textContent = custom || 'Thanks. Scroll up to see your name above.';
  c.classList.add('show');
  setTimeout(() => c.classList.remove('show'), 8000);
}

function resetForm() {
  ['f-name','f-address','f-headcount','f-email','f-phone','f-bringing','f-dish','f-ideas'].forEach(id => {
    document.getElementById(id).value = '';
  });
  document.querySelector('input[name="attending"][value="yes"]').checked = true;
  document.querySelectorAll('.check-row input').forEach(c => c.checked = false);
}

function escapeHtml(str) {
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}
</script>


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>The Little York Block Party — Saturday, August 1, 2026</title>
<meta name="description" content="First annual block party for the Little York loop in Northfield, Ohio. Saturday August 1, 2026. RSVP and sign up to bring something.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Patrick+Hand&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&display=swap" rel="stylesheet">
<style>
:root {
  --cream:        #faf3e3;
  --cream-deep:   #f0e6cd;
  --ink:          #1f1812;
  --ink-soft:     #4a3a2c;
  --tomato:       #d94427;
  --tomato-deep:  #a8321a;
  --sky:          #4a90a4;
  --grass:        #6b8e3a;
  --sunny:        #e8b13a;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  color-scheme: light;
  background: var(--cream);
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  background: var(--cream) !important;
  color: var(--ink) !important;
  color-scheme: light;
  font-family: 'Fraunces', Georgia, serif;
  font-size: 18px;
  line-height: 1.55;
  min-height: 100vh;
  forced-color-adjust: none;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
  background-image:
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch' seed='5'/><feColorMatrix values='0 0 0 0 0.12  0 0 0 0 0.09  0 0 0 0 0.07  0 0 0 0.07 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

.skip-link {
  position: absolute;
  left: -9999px;
  background: var(--ink);
  color: var(--cream);
  padding: 12px 18px;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 16px;
  text-decoration: none;
  z-index: 100;
}
.skip-link:focus {
  left: 12px; top: 12px;
  outline: 3px solid var(--tomato);
  outline-offset: 2px;
}

a:focus-visible, button:focus-visible, input:focus-visible,
select:focus-visible, textarea:focus-visible {
  outline: 3px solid var(--tomato);
  outline-offset: 3px;
}

::selection { background: var(--tomato); color: var(--cream); }

.page {
  max-width: 880px;
  margin: 0 auto;
  padding: 32px 24px 64px;
  position: relative;
}

.hero {
  text-align: center;
  padding: 24px 0 32px;
  position: relative;
}

.hero-string-lights {
  width: 100%;
  height: 60px;
  margin-bottom: 8px;
}
.hero-string-lights svg { width: 100%; height: 100%; display: block; }

.hero-tag {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 22px;
  color: var(--tomato);
  letter-spacing: 1px;
  margin-bottom: 8px;
  display: inline-block;
  transform: rotate(-2deg);
}

.hero h1 {
  font-family: 'Caveat Brush', cursive;
  font-weight: 400;
  font-size: clamp(56px, 11vw, 110px);
  line-height: 0.92;
  color: var(--ink);
  letter-spacing: -1px;
  margin: 4px 0 12px;
  text-shadow: 2px 2px 0 rgba(217, 68, 39, 0.12);
}

.hero h1 .accent {
  color: var(--tomato);
  display: inline-block;
  transform: rotate(-2deg);
}

.hero-subtitle {
  font-family: 'Patrick Hand', sans-serif;
  font-size: clamp(20px, 2.8vw, 26px);
  color: var(--ink);
  max-width: 540px;
  margin: 12px auto 0;
  line-height: 1.4;
}

.hero-date-strip {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  margin-top: 24px;
  padding: 14px 26px;
  background: var(--ink);
  color: var(--cream);
  font-family: 'Patrick Hand', sans-serif;
  font-size: 22px;
  letter-spacing: 1px;
  transform: rotate(-1deg);
  box-shadow: 4px 4px 0 var(--tomato);
}

.hero-date-strip .dot {
  width: 8px; height: 8px; background: var(--tomato);
  border-radius: 50%;
}

.illustration {
  margin: 32px auto 16px;
  max-width: 720px;
  padding: 0 20px;
}
.illustration svg {
  width: 100%; height: auto; display: block;
  color: var(--ink);
}

.invite {
  text-align: center;
  max-width: 600px;
  margin: 0 auto;
  padding: 32px 16px;
}

.invite-headline {
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(32px, 5vw, 44px);
  color: var(--ink);
  line-height: 1.05;
  margin-bottom: 20px;
}
.invite-headline .ink-red { color: var(--tomato); }

.invite p {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  line-height: 1.65;
  color: var(--ink);
  margin-bottom: 14px;
}
.invite p strong { color: var(--tomato-deep); font-weight: 600; }

.cta-row {
  margin-top: 32px;
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.cta {
  display: inline-block;
  padding: 16px 32px;
  background: var(--tomato);
  color: var(--cream);
  font-family: 'Patrick Hand', sans-serif;
  font-size: 22px;
  letter-spacing: 1px;
  text-decoration: none;
  border: 3px solid var(--ink);
  box-shadow: 5px 5px 0 var(--ink);
  cursor: pointer;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
  transform: rotate(-1deg);
}
.cta:hover { transform: rotate(-1deg) translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
.cta:active { transform: rotate(-1deg) translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }

.cta.cta-sky { background: var(--sky); transform: rotate(1deg); }
.cta.cta-sky:hover { transform: rotate(1deg) translate(-2px, -2px); }
.cta.cta-sky:active { transform: rotate(1deg) translate(2px, 2px); }

.squiggle {
  margin: 56px auto;
  max-width: 320px;
  height: 24px;
  color: var(--tomato);
  opacity: 0.65;
}
.squiggle svg { width: 100%; height: 100%; display: block; }

.whats-up {
  max-width: 820px;
  margin: 0 auto;
  padding: 0 16px;
}

.whats-up h2 {
  text-align: center;
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(36px, 5vw, 48px);
  color: var(--ink);
  margin-bottom: 36px;
  line-height: 1;
}
.whats-up h2 .underline-doodle {
  display: block;
  margin: 4px auto 0;
  width: 200px;
  color: var(--tomato);
}

.whats-up-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
@media (max-width: 700px) { .whats-up-grid { grid-template-columns: 1fr; gap: 20px; } }

.fun-card {
  background: var(--cream);
  padding: 28px 22px 24px;
  border: 3px solid var(--ink);
  text-align: center;
  position: relative;
  transition: transform 0.15s ease;
}
.fun-card:nth-child(1) { transform: rotate(-1.5deg); box-shadow: 5px 5px 0 var(--tomato); }
.fun-card:nth-child(2) { transform: rotate(0.8deg); box-shadow: 5px 5px 0 var(--sky); }
.fun-card:nth-child(3) { transform: rotate(-0.6deg); box-shadow: 5px 5px 0 var(--grass); }
.fun-card:hover { transform: rotate(0) translateY(-3px); }

.fun-card .icon { width: 64px; height: 64px; margin: 0 auto 12px; }
.fun-card .icon svg { width: 100%; height: 100%; }
.fun-card:nth-child(1) .icon { color: var(--tomato); }
.fun-card:nth-child(2) .icon { color: var(--sky); }
.fun-card:nth-child(3) .icon { color: var(--grass); }

.fun-card h3 {
  font-family: 'Caveat Brush', cursive;
  font-size: 36px;
  color: var(--ink);
  margin-bottom: 8px;
  line-height: 1;
}
.fun-card p {
  font-family: 'Fraunces', serif;
  font-size: 16px;
  line-height: 1.5;
  color: var(--ink);
}

.history {
  max-width: 640px;
  margin: 0 auto;
  padding: 32px 24px;
  position: relative;
}
.history-banner { text-align: center; margin-bottom: 24px; }
.history-banner .label {
  display: inline-block;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  color: var(--cream);
  background: var(--ink);
  padding: 6px 18px;
  letter-spacing: 1px;
  transform: rotate(-1deg);
}
.history h2 {
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(36px, 5vw, 48px);
  color: var(--ink);
  text-align: center;
  margin-bottom: 24px;
  line-height: 1;
}
.history h2 .a { color: var(--tomato); display: inline-block; transform: rotate(-3deg); }
.history p {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  line-height: 1.65;
  color: var(--ink);
  margin-bottom: 16px;
}
.history p strong { font-weight: 600; color: var(--tomato-deep); }

.history-coda {
  margin-top: 28px;
  padding: 22px 24px;
  background: var(--cream-deep);
  border-left: 5px solid var(--tomato);
  font-style: italic;
  font-size: 18px;
  line-height: 1.55;
  color: var(--ink);
  transform: rotate(-0.5deg);
}

.list-section {
  max-width: 780px;
  margin: 0 auto;
  padding: 0 16px;
}
.list-section h2 {
  text-align: center;
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(36px, 5vw, 48px);
  color: var(--ink);
  margin-bottom: 8px;
  line-height: 1;
}
.list-intro {
  text-align: center;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 20px;
  color: var(--ink);
  max-width: 480px;
  margin: 0 auto 32px;
  line-height: 1.4;
}

.list-paper {
  background: var(--cream);
  border: 3px solid var(--ink);
  padding: 32px 32px 36px;
  position: relative;
  box-shadow: 5px 5px 0 var(--ink);
}
@media (max-width: 540px) { .list-paper { padding: 24px 20px; } }
.list-paper::before {
  content: '';
  position: absolute;
  left: 24px; top: 0; bottom: 0;
  width: 1px;
  background: var(--tomato);
  opacity: 0.4;
}

.list-head {
  display: grid;
  grid-template-columns: 2fr 1.5fr 2fr;
  gap: 18px;
  padding-bottom: 12px;
  border-bottom: 2px dashed var(--ink);
  margin-bottom: 8px;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 16px;
  color: var(--tomato-deep);
  letter-spacing: 1px;
}
@media (max-width: 600px) { .list-head { display: none; } }

.list-row {
  display: grid;
  grid-template-columns: 2fr 1.5fr 2fr;
  gap: 18px;
  padding: 14px 0;
  border-bottom: 1px dashed var(--ink-soft);
  align-items: baseline;
}
.list-row:last-child { border-bottom: none; }
.list-row .r-name { font-family: 'Patrick Hand', sans-serif; font-size: 20px; color: var(--ink); }
.list-row .r-bringing { font-family: 'Fraunces', serif; font-style: italic; font-size: 18px; color: var(--tomato-deep); font-weight: 500; }
.list-row .r-note { font-family: 'Fraunces', serif; font-size: 16px; color: var(--ink); font-style: italic; }

@media (max-width: 600px) {
  .list-row { grid-template-columns: 1fr; gap: 4px; padding: 12px 0; }
  .list-row .r-bringing::before {
    content: 'bringing: ';
    font-family: 'Patrick Hand', sans-serif;
    font-style: normal;
    color: var(--tomato);
    margin-right: 4px;
  }
}

.list-empty {
  text-align: center;
  padding: 28px 16px;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 19px;
  color: var(--ink);
  font-style: italic;
}

.signup { max-width: 720px; margin: 0 auto; padding: 0 16px; }

.signup h2 {
  text-align: center;
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(40px, 6vw, 56px);
  color: var(--ink);
  margin-bottom: 8px;
  line-height: 1;
}
.signup h2 .accent { color: var(--tomato); display: inline-block; transform: rotate(-3deg); }

.signup-intro {
  text-align: center;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 20px;
  color: var(--ink);
  margin-bottom: 24px;
}

.signup-form {
  background: var(--cream);
  border: 3px solid var(--ink);
  padding: 36px 36px 32px;
  box-shadow: 6px 6px 0 var(--tomato);
}
@media (max-width: 540px) { .signup-form { padding: 24px 20px; } }

.notice {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 17px;
  color: var(--ink);
  background: var(--cream-deep);
  padding: 14px 18px;
  margin-bottom: 28px;
  border-left: 4px solid var(--sky);
  line-height: 1.45;
}
.notice strong { color: var(--tomato-deep); font-weight: normal; }

.field { margin-bottom: 22px; }

.field-label {
  display: block;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 19px;
  color: var(--ink);
  margin-bottom: 6px;
  line-height: 1.3;
}
.field-label .req { color: var(--tomato); margin-left: 2px; }

.tag {
  display: inline-block;
  margin-left: 6px;
  padding: 1px 8px;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 12px;
  color: var(--cream);
  background: var(--tomato);
  letter-spacing: 1px;
  vertical-align: 2px;
}
.tag.private { background: var(--sky); }

.field input[type="text"],
.field input[type="email"],
.field input[type="tel"],
.field input[type="number"],
.field select {
  width: 100%;
  background: var(--cream);
  border: 2px solid var(--ink);
  font-family: 'Fraunces', serif;
  font-size: 18px;
  color: var(--ink);
  padding: 10px 12px;
  border-radius: 0;
  appearance: none;
}
.field input::placeholder { color: rgba(31, 24, 18, 0.45); font-style: italic; }
.field input:focus, .field select:focus, .field textarea:focus {
  outline: none;
  border-color: var(--tomato);
  background: #fffaef;
}

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
@media (max-width: 540px) { .field-row { grid-template-columns: 1fr; gap: 22px; } }

.field textarea {
  width: 100%;
  background: var(--cream);
  border: 2px solid var(--ink);
  font-family: 'Fraunces', serif;
  font-size: 17px;
  line-height: 1.5;
  color: var(--ink);
  padding: 12px;
  min-height: 100px;
  resize: vertical;
  border-radius: 0;
}

fieldset { border: none; padding: 0; margin-bottom: 22px; }
fieldset legend {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 19px;
  color: var(--ink);
  margin-bottom: 10px;
}

.radio-row, .check-row { display: flex; flex-wrap: wrap; gap: 12px 22px; }
.radio-row label, .check-row label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: 'Fraunces', serif;
  font-size: 17px;
  color: var(--ink);
  cursor: pointer;
  padding: 4px 0;
}
.radio-row input, .check-row input {
  width: 20px; height: 20px;
  accent-color: var(--tomato);
  cursor: pointer;
}

.error-message {
  display: none;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 16px;
  color: var(--tomato);
  margin-top: 4px;
}
.error-message.show { display: block; }
.field input.error { border-color: var(--tomato); border-width: 3px; }

.submit-row {
  text-align: center;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 2px dashed var(--ink);
}
.submit-row .cta { font-size: 24px; }

.confirmation {
  display: none;
  margin-top: 24px;
  padding: 24px;
  background: var(--ink);
  color: var(--cream);
  text-align: center;
  transform: rotate(-0.5deg);
  box-shadow: 4px 4px 0 var(--tomato);
}
.confirmation.show { display: block; }
.confirmation h4 {
  font-family: 'Caveat Brush', cursive;
  font-size: 32px;
  color: var(--cream);
  margin-bottom: 4px;
}
.confirmation p {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  color: var(--cream);
}

.fb-block {
  max-width: 580px;
  margin: 0 auto;
  padding: 0 16px;
  text-align: center;
}
.fb-block h2 {
  font-family: 'Caveat Brush', cursive;
  font-size: clamp(32px, 4.5vw, 42px);
  color: var(--ink);
  margin-bottom: 8px;
  line-height: 1;
}
.fb-block p {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 22px;
  max-width: 460px;
  margin-left: auto; margin-right: auto;
}

.fb-cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 14px 28px;
  background: #1877f2;
  color: white;
  font-family: 'Patrick Hand', sans-serif;
  font-size: 19px;
  text-decoration: none;
  border: 3px solid var(--ink);
  box-shadow: 5px 5px 0 var(--ink);
  transform: rotate(-1deg);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.fb-cta:hover { transform: rotate(-1deg) translate(-2px, -2px); box-shadow: 7px 7px 0 var(--ink); }
.fb-cta:active { transform: rotate(-1deg) translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
.fb-cta svg { width: 22px; height: 22px; fill: currentColor; }

footer {
  margin-top: 80px;
  padding: 32px 16px 0;
  border-top: 3px dashed var(--ink);
  text-align: center;
}
footer p {
  font-family: 'Patrick Hand', sans-serif;
  font-size: 18px;
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 8px;
}
footer .signoff {
  font-family: 'Caveat Brush', cursive;
  font-size: 28px;
  color: var(--tomato);
  margin-top: 16px;
  transform: rotate(-1deg);
  display: inline-block;
}
footer a {
  color: var(--tomato-deep);
  text-decoration: none;
  border-bottom: 2px solid var(--tomato);
}
footer a:hover { color: var(--tomato); }

@keyframes popIn {
  0%   { opacity: 0; transform: translateY(20px) scale(0.96); }
  60%  { opacity: 1; transform: translateY(-4px) scale(1.01); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.hero, .illustration, .invite, .whats-up,
.history, .list-section, .signup, .fb-block {
  animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
.illustration { animation-delay: 0.1s; }
.invite { animation-delay: 0.2s; }
.whats-up { animation-delay: 0.3s; }
.history { animation-delay: 0.4s; }
.list-section { animation-delay: 0.5s; }
.signup { animation-delay: 0.6s; }
.fb-block { animation-delay: 0.7s; }

.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
</style>
</head>
<body>

<a href="#main" class="skip-link">Skip to content</a>

<div class="page">

  <header class="hero">

    <div class="hero-string-lights" aria-hidden="true">
      <svg viewBox="0 0 800 60">
        <path d="M0 8 Q 200 50, 400 28 T 800 8" stroke="#1f1812" stroke-width="1.5" fill="none"/>
        <g>
          <circle cx="80"  cy="28" r="6" fill="#e8b13a" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="80" y1="22" x2="80" y2="18" stroke="#1f1812" stroke-width="1"/>
          <circle cx="160" cy="40" r="6" fill="#d94427" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="160" y1="34" x2="160" y2="30" stroke="#1f1812" stroke-width="1"/>
          <circle cx="240" cy="44" r="6" fill="#4a90a4" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="240" y1="38" x2="240" y2="34" stroke="#1f1812" stroke-width="1"/>
          <circle cx="320" cy="40" r="6" fill="#e8b13a" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="320" y1="34" x2="320" y2="30" stroke="#1f1812" stroke-width="1"/>
          <circle cx="400" cy="32" r="6" fill="#6b8e3a" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="400" y1="26" x2="400" y2="22" stroke="#1f1812" stroke-width="1"/>
          <circle cx="480" cy="28" r="6" fill="#d94427" stroke="#1f1812" stroke-width="1.2"/>
          <line x1="480" y1="22" x2="480" y2="18" stroke="#1f1812" stroke-width="1"/>
